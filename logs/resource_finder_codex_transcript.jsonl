{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"pwd && source .venv/bin/activate && python - <<'PY'\nfrom pathlib import Path\nimport json, pandas as pd\nroot=Path('datasets'); samples=root/'samples'; samples.mkdir(exist_ok=True)\n# HC3\np=root/'HC3/all.jsonl'; n=0; domains={}; h_answers=a_answers=0; first=[]\nwith p.open(encoding='utf-8') as f:\n  for line in f:\n    x=json.loads(line); n+=1; domains[x.get('source','unknown')]=domains.get(x.get('source','unknown'),0)+1\n    h_answers+=len(x.get('human_answers',[])); a_answers+=len(x.get('chatgpt_answers',[]))\n    if len(first)<5: first.append(x)\n(samples/'hc3_examples.json').write_text(json.dumps(first,indent=2,ensure_ascii=False),encoding='utf-8')\nprint('HC3',n,'records',h_answers,'human answers',a_answers,'chatgpt answers','domains',domains,'schema',list(first[0]))\n# HAP-E\ninfos=[]; first=[]\nfor p in sorted((root/'human-ai-parallel-corpus/text_data').glob('*.parquet')):\n  df=pd.read_parquet(p)\n  infos.append((p.name,len(df),list(df.columns),int(df.isna().sum().sum())))\n  if len(first)<10: first.extend(df.head(2).to_dict('records'))\n(samples/'hape_examples.json').write_text(json.dumps(first[:10],indent=2,ensure_ascii=False,default=str),encoding='utf-8')\nprint('HAPE')\nfor x in infos: print(x)\n# MAGE chunked stats\nfirst=[]\nfor p in sorted((root/'MAGE').glob('*.csv')):\n  count=0; nulls=None; cols=None\n  for chunk in pd.read_csv(p,chunksize=50000):\n    count += len(chunk); cols=list(chunk.columns)\n    ns=chunk.isna().sum(); nulls=ns if nulls is None else nulls.add(ns,fill_value=0)\n    if not first: first=chunk.head(5).to_dict('records')\n  print('MAGE',p.name,'rows',count,'cols',cols,'nulls',nulls.astype(int).to_dict())\n(samples/'mage_examples.json').write_text(json.dumps(first,indent=2,ensure_ascii=False,default=str),encoding='utf-8')\n# RAID local sample\np=root/'raid/train_sample.parquet'; df=pd.read_parquet(p)\nprint('RAID sample',len(df),'schema',list(df.columns),'nulls',df.isna().sum().to_dict())\n(samples/'raid_examples.json').write_text(json.dumps(df.groupby(df.model.eq('human'),group_keys=False).head(3).to_dict('records'),indent=2,ensure_ascii=False,default=str),encoding='utf-8')\nfor p in sorted(samples.glob('*')): print('sample_file',p,p.stat().st_size)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
